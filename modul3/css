/* Reset & Base */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--bg);
    color: var(--text-main);
    padding: 20px;
    max-width: 1000px;
    margin: 0 auto;
}

/* Header */
header {
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    color: white;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    margin-bottom: 25px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}

header h1 {
    font-size: 2em;
    margin-bottom: 8px;
}

header p {
    color: #b0b0b0;
    font-size: 1em;
}

/* Stat Cards */
.stat-card {
    background: var(--card-bg);
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    text-align: center;
    border-left: 4px solid var(--primary);
}

.stat-card h3 {
    font-size: 0.9em;
    color: var(--text-muted);
    margin-bottom: 8px;
}

.stat-card .value {
    font-size: 1.8em;
    font-weight: bold;
    color: var(--text-main);
}

.stat-card.over {
    border-left-color: var(--danger);
}

.stat-card.over .value {
    color: var(--danger);
}

/* Form */
.form-container {
    background: var(--card-bg);
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    margin-bottom: 25px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-size: 0.85em;
    color: var(--text-muted);
    margin-bottom: 6px;
    font-weight: 600;
}

.form-group input,
.form-group select {
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.95em;
    outline: none;
    transition: border 0.2s;
}

.form-group input:focus,
.form-group select:focus {
    border-color: var(--primary);
}

/* Buttons */
.btn-primary {
    background: var(--primary);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95em;
    transition: background 0.2s;
}

.btn-primary:hover {
    background: #1d4ed8;
}

.btn-cancel {
    background: #e0e0e0;
    color: #333;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95em;
    margin-left: 8px;
}

.btn-cancel:hover {
    background: #ccc;
}

/* Table */
.table-container {
    background: var(--card-bg);
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

thead {
    background: #1a1a2e;
    color: white;
}

th, td {
    padding: 12px 15px;
    text-align: left;
    border-bottom: 1px solid var(--border);
}

th {
    font-weight: 600;
    font-size: 0.9em;
}

tbody tr:hover {
    background: #f8f9fa;
}

.empty-state {
    text-align: center;
    color: #999;
    font-style: italic;
    padding: 30px !important;
}

/* Badge Kategori */
.badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.8em;
    font-weight: 600;
}

.badge-makan { background: #fef3c7; color: #92400e; }
.badge-transport { background: #dbeafe; color: #1e40af; }
.badge-kuota { background: #d1fae5; color: #065f46; }
.badge-lainnya { background: #f3f4f6; color: #374151; }

/* Action buttons */
.action-btn {
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85em;
    margin-right: 5px;
    color: white;
}

.btn-edit { background: #f0ad4e; }
.btn-delete { background: var(--danger); }